{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@inspo/db": ["../../packages/db/src/index.ts"],
      "@inspo/shared": ["../../packages/shared/src/index.ts"],
      "@inspo/taxonomy": ["../../packages/taxonomy/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
