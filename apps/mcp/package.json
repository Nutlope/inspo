{
  "name": "@inspo/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "exports": {
    ".": "./src/server.ts",
    "./http": "./src/http-handler.ts",
    "./tools": "./src/tools.ts"
  },
  "bin": {
    "inspo-mcp": "./bin/inspo-mcp.js"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/server.ts",
    "test": "tsx src/smoke.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inspo/db": "workspace:*",
    "@inspo/shared": "workspace:*",
    "@inspo/taxonomy": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251201.0",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
