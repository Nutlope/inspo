# ─── Database ─────────────────────────────────────────────────
# Neon connection string. Without this, the gallery falls back to
# fixtures (so dev still works). Get one at https://neon.tech →
# create project → copy the pooled connection string.
DATABASE_URL=

# ─── Capture worker (Task 3) ─────────────────────────────────
# Cloudflare R2 — for storing captured PNG/AVIF assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=inspo-captures
R2_PUBLIC_URL=

# Anthropic — for Claude Sonnet vision tagging
ANTHROPIC_API_KEY=

# Voyage AI — for multimodal + text embeddings
VOYAGE_API_KEY=

# ─── Auth (later) ─────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
