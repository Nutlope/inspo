# ─── Database (optional) ──────────────────────────────────────
# Neon connection string. The catalogue ships from a static seed
# (packages/db/src/static-screens.json), so the gallery + MCP work
# fully WITHOUT a database — this is only needed if you want to run
# the live Neon-backed path. Get one at https://neon.tech → create
# project → copy the pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── Together AI ─────────────────────────────────────────────
# Powers the capture worker's enrichment:
#   • vision tagging   — google/gemma-3n-E4B-it
#   • text embeddings  — intfloat/multilingual-e5-large-instruct (1024-dim)
# Get a key at https://api.together.ai
TOGETHER_API_KEY=

# ─── Capture asset storage (Vercel Blob) ─────────────────────
# Read/write token for the Vercel Blob store that hosts captured
# PNG/AVIF/WebP assets. Used by apps/worker/src/upload-to-blob.ts
# and read back by the MCP server. Create a store in the Vercel
# dashboard → Storage → Blob, then copy its RW token.
BLOB_READ_WRITE_TOKEN=

# ─── Auth (apps/web) ─────────────────────────────────────────
# better-auth — only needed if you enable the authenticated web
# routes. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# NOTE: in production BOTH of the above are required - the app throws on
# boot if BETTER_AUTH_SECRET / BETTER_AUTH_URL are unset when
# NODE_ENV=production (so it can't silently sign sessions with the dev
# fallback). Generate the secret with: openssl rand -base64 32

# ─── Web URLs / SEO (apps/web) ───────────────────────────────
# Canonical production origin for metadataBase, sitemap, robots, and OG
# URLs. On Vercel this auto-falls back to VERCEL_PROJECT_PRODUCTION_URL,
# so set it explicitly only once the production domain is final.
INSPO_BASE_URL=

# ─── Catalogue / assets (MCP server + worker) ────────────────
# Override the CDN the MCP Worker / `npx inspo-mcp` fetch the seed from
# (defaults to the published Vercel Blob store).
# INSPO_CATALOGUE_URL=
# Host that serves captured screenshots (image src + preconnect hint).
# INSPO_BLOB_BASE_URL=
# Set to 1 (with DATABASE_URL) to serve reads from Neon instead of the
# bundled static seed. Off by default.
# INSPO_USE_DB=

# ─── Extract feature (apps/web → apps/worker) ────────────────
# The capture worker's HTTP endpoint that /api/extract proxies to, and
# the bearer token it must present. Leave unset to disable the extract UI.
# INSPO_WORKER_URL=
# INSPO_WORKER_TOKEN=

# ─── Model overrides (apps/worker, optional) ─────────────────
# Defaults live in code; override the Together model ids if needed.
# INSPO_VISION_MODEL=
# INSPO_EMBED_MODEL=
# INSPO_AUTOPSY_MODEL=
