# ─── Database ─────────────────────────────────────────────────
# Neon connection string. Without this, the gallery falls back to
# fixtures (so dev still works). Get one at https://neon.tech →
# create project → copy the pooled connection string.
DATABASE_URL=

# ─── Together AI ─────────────────────────────────────────────
# Powers the capture worker:
#   • vision tagging — Qwen/Qwen3-VL-8B-Instruct
#   • text embeddings — BAAI/bge-large-en-v1.5 (1024-dim)
# Get a key at https://api.together.ai
TOGETHER_API_KEY=

# ─── Capture worker storage (later) ──────────────────────────
# Cloudflare R2 — for storing captured PNG/AVIF assets when ready
# to graduate from local FS to a CDN.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=inspo-captures
R2_PUBLIC_URL=

# ─── Auth ─────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
